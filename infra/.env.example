# B3 consumer configuration for the Shared AI Platform.
# No shared service is started from this repository.
#
# Endpoints below are defaults and may be overridden in the shell.
B3_EMBEDDING_URL=http://127.0.0.1:8093
B3_QDRANT_URL=http://127.0.0.1:6333
B3_NEO4J_URI=bolt://127.0.0.1:7687
B3_NEO4J_USER=neo4j
#
# Keep credentials local. Never commit a real password.
NEO4J_PASSWORD=change-me-local-only
#
# Current Ubuntu deployment can instead source the shared platform environment:
# B3_SHARED_PLATFORM_ENV=/opt/joao-runtime/joao.env
