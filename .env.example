# B3 Investment & Options Agent
# Copy this file to .env for local configuration.
# Never commit .env.

B3_AGENT_ENV=development
B3_AGENT_TIMEZONE=America/Sao_Paulo

# Optional: override project directories
# B3_AGENT_PROJECT_ROOT=
# B3_AGENT_DATA_DIR=
# B3_AGENT_LOGS_DIR=

# Obsidian
# Example:
# B3_AGENT_OBSIDIAN_VAULT=C:\Users\Edmilson\Documents\Obsidian\B3-Investments

# Local vector store
B3_AGENT_QDRANT_URL=http://localhost:6333
B3_AGENT_QDRANT_COLLECTION=b3_evidence

# LLM
B3_AGENT_LLM_ENABLED=false
B3_AGENT_LLM_MODEL=gpt-5.6-luna
B3_AGENT_MAX_LLM_COST_USD=1.00

# API keys will NOT be stored in this repository.
# Configure them through environment variables when needed.
